{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shertwg internal InputFrame v1; not a Motorica API",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seq", "timestamp_ms", "channel_a", "channel_b", "connected", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "seq": {"type": "integer", "minimum": 0},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "channel_a": {"type": "number", "minimum": 0, "maximum": 1},
    "channel_b": {"type": "number", "minimum": 0, "maximum": 1},
    "connected": {"type": "boolean"},
    "source": {"enum": ["manual_emulator", "replay"]}
  },
  "allOf": [{
    "if": {"properties": {"connected": {"const": false}}},
    "then": {"properties": {"channel_a": {"const": 0}, "channel_b": {"const": 0}}}
  }]
}
